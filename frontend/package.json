{
  "name": "flowcity",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "ng serve --host 0.0.0.0 --proxy-config proxy.conf.json",
    "build": "ng build",
    "test:e2e": "node ../scripts/smoke.mjs",
    "lint": "eslint .. --max-warnings=0",
    "lint:fix": "eslint .. --fix --max-warnings=0",
    "format": "prettier --ignore-path ../.prettierignore --write .. && npm run format:csharp",
    "format:check": "prettier --ignore-path ../.prettierignore --check .. && dotnet format whitespace ../backend/FlowCity.sln --no-restore --verify-no-changes",
    "format:csharp": "dotnet format whitespace ../backend/FlowCity.sln --no-restore"
  },
  "dependencies": {
    "@angular/animations": "^21.2.0",
    "@angular/cdk": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/material": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.22",
    "@fontsource/inter": "^5.3.0",
    "@lucide/angular": "^1.73.0",
    "cytoscape": "^3.33.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/cytoscape": "^3.21.9",
    "angular-eslint": "^22.7.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "playwright": "^1.63.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2"
  }
}
